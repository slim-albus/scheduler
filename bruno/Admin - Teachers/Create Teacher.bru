meta {
  name: Create Teacher
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/teachers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Dr. Alan Turing",
    "email": "alan.turing@university.edu",
    "department": "Computer Science",
    "type": "PROFESSOR",
    "availabilityBitmask": -1,
    "maxClassesPerDay": 3,
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("teacherId", res.body.id);
  }
}
