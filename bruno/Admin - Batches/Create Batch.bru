meta {
  name: Create Batch
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/batches
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Class of 2030",
    "program": "Computer Science",
    "year": "Freshman",
    "semesterId": "{{semesterId}}",
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");
  expect(res.body.semesterId).to.equal(bru.getEnvVar("semesterId"));

  if (res.status === 200) {
    bru.setEnvVar("batchId", res.body.id);
  }
}
