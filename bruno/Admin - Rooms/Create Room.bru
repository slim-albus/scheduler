meta {
  name: Create Room
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/rooms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Room 101",
    "type": "LECTURE_HALL",
    "capacity": 100,
    "building": "Main",
    "level": 1,
    "hasTv": true,
    "hasProjector": true,
    "availabilityBitmask": -1,
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("roomId", res.body.id);
  }
}
