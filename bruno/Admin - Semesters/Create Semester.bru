meta {
  name: Create Semester
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/semesters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Fall 2026",
    "code": "FA26",
    "startDate": "2026-09-01T00:00:00",
    "endDate": "2026-12-15T00:00:00",
    "weeks": 15,
    "academicYear": "2026-2027",
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");
  expect(res.body.code).to.equal("FA26");

  if (res.status === 200) {
    bru.setEnvVar("semesterId", res.body.id);
  }
}
