meta {
  name: Get Semester
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/semesters/{{semesterId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.equal(bru.getEnvVar("semesterId"));
}
