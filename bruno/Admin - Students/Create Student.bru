meta {
  name: Create Student
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/students
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Jane Doe",
    "studentId": "S12345",
    "email": "jane.doe@university.edu",
    "sectionId": "{{sectionId}}",
    "batchId": "{{batchId}}",
    "labGroup": 1,
    "program": "Computer Science",
    "year": "Freshman",
    "semesterId": "{{semesterId}}",
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("studentId", res.body.id);
  }
}
