meta {
  name: Create Section
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/sections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Section A",
    "batchId": "{{batchId}}",
    "labGroup": 1,
    "studentCount": 30,
    "semesterId": "{{semesterId}}",
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("sectionId", res.body.id);
  }
}
