meta {
  name: Create Mapping
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/mappings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "batchId": "{{batchId}}",
    "courseId": "{{courseId}}",
    "lectureTeacherId": "{{teacherId}}",
    "labInstructorId": "{{teacherId}}",
    "isRequired": true,
    "semesterId": "{{semesterId}}"
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("mappingId", res.body.id);
  }
}
