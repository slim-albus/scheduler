meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin_user",
    "password": "password"
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body).to.have.property("token");

  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}
