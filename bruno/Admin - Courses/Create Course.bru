meta {
  name: Create Course
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "CS101",
    "name": "Introduction to Computer Science",
    "hasLab": true,
    "credits": 4,
    "lectureHoursPerWeek": 3,
    "labHoursPerWeek": 2,
    "midtermDuration": 60,
    "finalDuration": 120,
    "department": "Computer Science",
    "active": true
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("courseId", res.body.id);
  }
}
