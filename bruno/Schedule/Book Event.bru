meta {
  name: Book Event
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/schedule/event
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "LECTURE",
    "topic": "Introduction to AI",
    "sectionId": "{{sectionId}}",
    "courseId": "{{courseId}}",
    "teacherId": "{{teacherId}}",
    "roomId": "{{roomId}}",
    "semesterId": "{{semesterId}}",
    "batchId": "{{batchId}}",
    "day": 1,
    "period": 1,
    "durationMinutes": 60,
    "instance": 1,
    "status": "SCHEDULED"
  }
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.be.a("string");

  if (res.status === 200) {
    bru.setEnvVar("eventId", res.body.id);
  }
}
