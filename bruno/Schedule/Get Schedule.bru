meta {
  name: Get Schedule
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/schedule?semesterId={{semesterId}}&sectionId={{sectionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body).to.be.an("array");
}
