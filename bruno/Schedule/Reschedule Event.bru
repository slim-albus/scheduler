meta {
  name: Reschedule Event
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/schedule/event/{{eventId}}/reschedule?day=2&period=3&roomId={{roomId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  expect(res.status).to.equal(200);
  expect(res.body.id).to.equal(bru.getEnvVar("eventId"));
  expect(res.body.day).to.equal(2);
  expect(res.body.period).to.equal(3);
}
